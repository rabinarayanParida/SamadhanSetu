# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sicp_portal
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# AI Problem Intelligence Microservice
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=your_internal_service_token
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
